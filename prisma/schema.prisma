generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String
  price       Float?
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  sizes       String?
  colors      String?
  images      ProductImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  color     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model StoreSettings {
  id            Int      @id @default(1)
  storeName     String   @default("Hadassa")
  tagline       String   @default("Moda com Propósito")
  whatsapp      String?
  instagram     String?
  mpAccessToken String?
  mpPublicKey   String?
  updatedAt     DateTime @updatedAt
}
