# Banco de dados local (não precisa mudar para uso local)
DATABASE_URL="file:./dev.db"

# Senha para entrar no painel admin (/admin) — TROQUE isso antes de publicar o site
ADMIN_PASSWORD="troque-esta-senha"

# Texto secreto usado para assinar a sessão de login do admin — TROQUE por qualquer frase aleatória
ADMIN_SESSION_SECRET="troque-por-uma-frase-aleatoria-bem-grande"

# URL pública do site (usada nos links de retorno do Mercado Pago). Em produção, coloque a URL do Vercel.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
